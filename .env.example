# Required for discovery (`run`, and `task` when it falls back to discovery): replace with your own key
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for the discovery loop (default: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: the local router model and its Ollama endpoint (used only by `cli.py task`); these are the defaults
ROUTER_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# Replay signs back in with these if the app's session expires (the mock bank's demo login; use your own console's)
CONSOLE_USERNAME=teller
CONSOLE_PASSWORD=teller-demo-pass
